# Открыть Kitty терминал по Win + Q
super + q
    kitty

# Открыть Firefox по Win + B
super + b
    firefox

# Открыть Dolphin по Win + E
super + e
    dolphin

# Переключить окно в плавающий режим / плитку по Win + V
super + v
    bspc node -t ~floating

# Закрыть активное окно по Win + C
super + c
    bspc node -c

# Переключиться на рабочий стол 1-9 (или 0 для десятого)
super + {1-9,0}
    bspc desktop -f {1-9,10}

# Переместить активное окно на рабочий стол 1-9 (Win + Shift + 1-9)
super + shift + {1-9,0}
    bspc node -d {1-9,10}

# Перезапустить bspwm (Win + Alt + R)
super + alt + r
    bspc wm -r
